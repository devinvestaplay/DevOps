{
  "name": "@investaplay/devops-api",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "create-admin": "tsx src/create-admin.ts",
    "test": "tsx --test --test-concurrency=1 src/auth.test.ts src/app.test.ts src/integrations.test.ts src/github.test.ts src/expo.test.ts src/aws.test.ts src/deploy-executor/template.test.ts src/deploy.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-ec2": "3.1139.0",
    "@aws-sdk/client-ssm": "3.1139.0",
    "@aws-sdk/client-sts": "3.1139.0",
    "@investaplay/devops-contracts": "0.0.0",
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "dotenv": "18.0.3",
    "drizzle-orm": "0.45.3",
    "eas-cli": "24.7.0",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "json5": "2.2.3",
    "mysql2": "3.24.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "26.6.2",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.11",
    "supertest": "7.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
